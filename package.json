{
  "name": "ffgpt",
  "version": "0.1.0",
  "description": "Fire-and-forget prompts to ChatGPT through Firefox WebDriver BiDi",
  "type": "module",
  "bin": {
    "ffgpt": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
